# --- Supabase (Project Settings → API) ---
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Solo servidor. Hoy el código no la usa; queda reservada para tareas administrativas futuras.
SUPABASE_SERVICE_ROLE_KEY=

# --- OpenRouter (solo servidor) ---
OPENROUTER_API_KEY=
# Modelo barato y rápido; se cambia acá (y en Vercel) sin tocar código.
OPENROUTER_MODEL=openai/gpt-4o-mini

# --- App ---
# Referencia: hoy la zona horaria está fija en src/lib/dates.ts y en la función SQL
# public.local_day (supabase/migrations/0001_init.sql). Si la cambias, actualiza ambos.
APP_TIMEZONE=America/Argentina/Buenos_Aires
